{
  "expo": {
    "name": "Nityo Ponno",
    "slug": "nityoponno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/splash.png",
    "backgroundColor": "transparent",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shuvajitmaitra.nityoponno"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#facc14"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.shuvajitmaitra.nityoponno",
      "appName": "Nityo Ponno",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./src/assets/icon.jpg",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#facc14",
          "image": "./src/assets/splash.png",
          "dark": {
            "image": "./src/assets/splash.png",
            "backgroundColor": "#facc14"
          },
          "imageWidth": 200
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0d8e7f28-3561-4084-b9cb-97e90ae84346"
      }
    }
  }
}
